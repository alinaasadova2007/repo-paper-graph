# Без токена GitHub API даёт 60 запросов/час, для одной организации хватает впритык.
GITHUB_TOKEN=
# Если задано, сырые ответы API пишутся в MongoDB, иначе в data/raw/*.json
# MONGO_URI=mongodb://localhost:27017
MONGO_DB=paperlink
# Если задано, граф загружается в Neo4j, иначе экспортируется в results/graph.cypher
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=paperlink-dev
OPENALEX_MAILTO=you@example.com
# Бесплатный ключ OpenAlex: https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
